  a :Marriage;
  :spouse _:coretta, :MLK;
  :offspring ( :MLK3 :DSK :YK [:name "Bernice King"]);
].

:MLK3 :name "Martin Luther King III".
:DSK :name "Dexter Scott King".
:YK :name "Yolanda King".

