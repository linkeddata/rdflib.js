{
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "moduleResolution": "node",
    "rootDir": "./src",
    "allowSyntheticDefaultImports": true,
    "checkJs": false,
    "allowJs": true,
    "target": "es2019",
    "module": "esnext",
    "strict": true,
    "noImplicitAny": false,
    "noUnusedLocals": true,
    "skipLibCheck": true /* Skip type checking of declaration files in node_modules */,
    "lib": [
      "es2019",
      "dom"
    ],
    "types": [
      "node"
    ],
    "outDir": "./temp_ts_output"
  },
  "include": [
    "src/**/*"
  ]
}